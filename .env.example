NODE_ENV=development
PORT=3000
# Local development replica set, started with npm run dev:db.
# For Atlas use your own password-encoded URI, authSource=admin, and database status_pulse.
MONGODB_URI=mongodb://127.0.0.1:27018/status_pulse?replicaSet=status-pulse-dev
MONGODB_DATABASE=status_pulse
PUBLIC_BASE_URL=http://localhost:3000
WORKER_CONCURRENCY=4
WORKER_POLL_MS=1000
SESSION_TTL_HOURS=24
# Demo payment support; email has its own independent configuration below.
ENABLE_SIMULATIONS=true
# Email is disabled locally and on Render until a sender and key are configured.
# Set EMAIL_MODE=resend when connecting real email.
# EMAIL_MODE=resend
# Assignment demonstrations only: explicitly set EMAIL_MODE=simulation.
# Simulated messages never reach an inbox. Production rejects simulation mode.
# Real email: add both settings in Render, using a verified sending domain.
# EMAIL_FROM=Status Pulse <notifications@your-verified-domain.example>
# RESEND_API_KEY=your-provider-key
# Add each provider's matching pair to enable its sign-in button.
# GOOGLE_CLIENT_ID=your-web-client-id
# GOOGLE_CLIENT_SECRET=your-web-client-secret
# GITHUB_CLIENT_ID=your-oauth-app-client-id
# GITHUB_CLIENT_SECRET=your-oauth-app-client-secret
CREATOR_NAME=Sir. Kuku
CREATOR_URL=https://github.com/Sir-kuku
# Full setup: docs/email-and-sign-in-setup.md
# Promote an existing account locally using npm run admin -- --email email@example.com.
