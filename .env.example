NODE_ENV=development
PORT=3000
# Local development replica set, started with npm run dev:db.
# For Atlas use your own password-encoded URI, authSource=admin, and database status_pulse.
MONGODB_URI=mongodb://127.0.0.1:27018/status_pulse?replicaSet=status-pulse-dev
MONGODB_DATABASE=status_pulse
PUBLIC_BASE_URL=http://localhost:3000
WORKER_CONCURRENCY=4
WORKER_POLL_MS=1000
SESSION_TTL_HOURS=24
# Production requires HTTPS; simulations are required by the assignment, never real payments.
ENABLE_SIMULATIONS=true
# Promote an existing account locally using npm run admin -- --email email@example.com.
